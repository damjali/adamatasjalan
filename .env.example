# Google Drive photo source. Copy to .env.local and fill in (see README).
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Supabase (site texts live in the site_texts table, see supabase/site_texts.sql)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Admin login for editing text on the site
ADMIN_USERNAME=
ADMIN_PASSWORD=
